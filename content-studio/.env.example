# ─── Database ───────────────────────────────────────────
# PostgreSQL connection string (used by Prisma CLI and the app)
DATABASE_URL="postgresql://studio:studio@localhost:5432/content_studio_dev?schema=public"

# Direct (non-pooled) URL used only for migrations. Optional; Neon on Vercel sets it automatically.
DATABASE_URL_UNPOOLED=""

# ─── App ────────────────────────────────────────────────
# Allow new sign-ups ("true" / "false"). Turn off after creating your account if the app is public.
ALLOW_SIGNUP="true"

# ─── AI ─────────────────────────────────────────────────
# "anthropic" or "mock". "mock" works without any API key (rule-based demo output).
# If unset: "anthropic" when ANTHROPIC_API_KEY is present, otherwise "mock".
AI_PROVIDER=""
# Server-side only. Never expose this with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=""
# Optional overrides
AI_MODEL="claude-opus-5-5"
AI_EFFORT="medium"

# ─── Storage ────────────────────────────────────────────
# "local" (files under STORAGE_LOCAL_DIR), "s3" (AWS S3 / Cloudflare R2 / MinIO) or "vercel-blob".
# If unset: "vercel-blob" when BLOB_READ_WRITE_TOKEN exists (Vercel sets it when a Blob store is connected), else "local".
STORAGE_DRIVER=""
STORAGE_LOCAL_DIR="./storage"
# Max upload size in MB
UPLOAD_MAX_MB="200"

# Vercel Blob (set automatically on Vercel when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=""

# S3-compatible settings (only when STORAGE_DRIVER="s3")
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
