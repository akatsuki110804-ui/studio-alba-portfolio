# Copy to .env and fill in only what you use. Never commit .env.

# Claude API — only needed when config/settings.yaml has llm.provider: anthropic.
# Alternatively run `ant auth login`; the SDK picks up that profile without this variable.
ANTHROPIC_API_KEY=

# Higgsfield is used through Claude Code's MCP connector (signed in via claude.ai), so no key is needed here.
